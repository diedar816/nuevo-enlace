
########################################
# BACKEND – NODE / NESTJS
########################################

# Dependencias
node/node_modules/

# Build TypeScript
node/dist/

# TS Build Info
node/**/*.tsbuildinfo

# JS generados por Nest fuera de dist
node/**/*.js
node/**/*.js.map

# Logs de Node
node/npm-debug.log*
node/yarn-debug.log*
node/pnpm-debug.log*

# Caches
.turbo/
.cache/

########################################
# FRONTEND – REACT + VITE
########################################

Tablero/node_modules/
Tablero/dist/
Tablero/dist-ssr/
Tablero/.vite/
Tablero/.env
Tablero/.env.*
Tablero/*.local

# Evitar subir dependencias de Vite
Tablero/.pnpm/

########################################
# PYTHON
########################################

__pycache__/
*.pyc
*.pyo
*.pyd

.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

########################################
# ENTORNOS / SECRETOS
########################################

.env
.env.*

